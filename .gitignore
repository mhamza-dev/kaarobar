# =====================================
# Root project ignore rules
# =====================================

# Dependencies
node_modules/
**/node_modules/
.pnpm-store/
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.*
!.env.example
!.env.sample
**/.env
**/.env.*
**/.env.local
**/.env.development
**/.env.production
**/.env.test

# Build / output folders
**/dist/
**/dist-ssr/
**/build/
**/out/
**/.next/
**/.nuxt/
**/.vite/
**/.turbo/
**/.cache/
**/coverage/
**/release/
**/release*/
**/web-build/
**/.parcel-cache/

# Desktop app outputs
**/dist-electron/
**/release/
**/*.app
**/*.dmg
**/*.exe
**/*.AppImage
**/*.deb
**/*.msi
**/*.zip

# Mobile app generated folders
**/android/
**/ios/
**/.expo/
**/.kotlin/
**/.metro-health-check*
**/expo-env.d.ts
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.orig.*

# Web / Next.js
.next/
out/
.vercel/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.pem

# TypeScript / tooling
*.tsbuildinfo
next-env.d.ts

# Local temp / generated assets
.tmp/
tmp/
cache/
*.local

# Project-specific generated data
**/uploads/
**/assets/
**/database/*.sqlite
**/database/*.db
**/*.sqlite-journal

# Optional: keep secret or local-only config out
**/local.env
**/secrets.*
**/*.secret
