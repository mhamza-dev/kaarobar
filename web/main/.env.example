# Copy to .env.local and adjust.

# The Phoenix backend's API base URL, including /api/v1.
# Local dev, backend run via `mix phx.server` or docker compose:
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Optional. The marketing site (web/landing), and where the other Kaarobar
# apps are published. Left empty, the welcome screen says "coming soon"
# rather than linking nowhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
