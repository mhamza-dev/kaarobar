# Copy to .env.local and adjust.

# The Phoenix API, including /api/v1. Read on the server only — the pricing
# page fetches the public plan catalogue (GET /plans) at render time.
KAAROBAR_API_URL=http://localhost:4000/api/v1

# This site's own public URL — canonical links, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The web app (web/main). "Start free trial" goes to <APP>/register?plan=…
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where people reach you. Shown on the contact page and in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@kaarobar.app
# Optional: international format, digits only (e.g. 923001234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: where the other apps are published. Empty shows "Coming soon".
NEXT_PUBLIC_DESKTOP_WINDOWS_URL=
NEXT_PUBLIC_DESKTOP_MAC_URL=
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
