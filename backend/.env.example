# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Postgres (docker-compose service) --------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_dev
POSTGRES_PORT=5432

# --- App --------------------------------------------------------------------
MIX_ENV=dev
PORT=4000
PHX_HOST=localhost

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Base64-encoded 32-byte key used by Cloak to encrypt secrets and PII at rest.
# Generate with: openssl rand -base64 32
CLOAK_KEY=e2xKQ0lWNjZmSmZqM2NWWXk1c2h1WHV3aVJqNGRnT0k9

# --- Production only --------------------------------------------------------
# DATABASE_URL=ecto://user:pass@host/database
# SECRET_KEY_BASE=            # mix phx.gen.secret
# POOL_SIZE=10
# ECTO_IPV6=false
# DNS_CLUSTER_QUERY=

# LiveDashboard at /admin/dashboard, behind HTTP Basic Auth. Unset in any
# environment, the route answers 404 rather than 401 — see
# KaarobarWeb.Plugs.DashboardAuth.
# DASHBOARD_USERNAME=
# DASHBOARD_PASSWORD=
