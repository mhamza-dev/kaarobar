# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Postgres (docker-compose service) --------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_dev
POSTGRES_PORT=5432

# --- App --------------------------------------------------------------------
MIX_ENV=dev
PORT=4000
PHX_HOST=localhost

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# The web app, which owns the pages emailed links open (password reset,
# email confirmation, invitations) and where Stripe returns after checkout.
# FRONTEND_URL=http://localhost:3000

# --- Subscription billing by card (optional) ---------------------------------
# Kaarobar's own Stripe account — what organizations pay for their plan. Unset,
# subscriptions are invoiced and settled by hand, and clients hide "pay by
# card". Register <API>/api/v1/webhooks/billing/stripe in the Stripe dashboard
# with: checkout.session.completed, customer.subscription.created/updated/
# deleted, invoice.paid, invoice.payment_failed. A plan's external_price_id is
# used when set; otherwise its price is sent to Checkout inline.
# STRIPE_BILLING_SECRET_KEY=sk_test_...
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Base64-encoded 32-byte key used by Cloak to encrypt secrets and PII at rest.
# Generate with: openssl rand -base64 32
CLOAK_KEY=e2xKQ0lWNjZmSmZqM2NWWXk1c2h1WHV3aVJqNGRnT0k9

# --- Production only --------------------------------------------------------
# DATABASE_URL=ecto://user:pass@host/database
# SECRET_KEY_BASE=            # mix phx.gen.secret
# POOL_SIZE=10
# ECTO_IPV6=false
# DNS_CLUSTER_QUERY=

# LiveDashboard at /admin/dashboard, behind HTTP Basic Auth. Unset in any
# environment, the route answers 404 rather than 401 — see
# KaarobarWeb.Plugs.DashboardAuth.
# DASHBOARD_USERNAME=
# DASHBOARD_PASSWORD=
