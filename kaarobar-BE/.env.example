# Database
DATABASE_URL=ecto://postgres:postgres@localhost/kaarobar_dev
# Optional overrides used by config/dev.exs defaults:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Endpoint
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-output-at-least-64-bytes
PHX_HOST=localhost
PORT=4000

# Auth
GUARDIAN_SECRET_KEY=replace-with-long-random-secret

# Integrations (FBR, billing webhooks, push)
#
# Safepay — Pakistan SaaS billing (JazzCash / Easypaisa / local cards). ADM-FR-003.
# Create plans in the Safepay merchant dashboard, then set plan IDs below.
# Webhook: POST /api/v1/billing/webhook  (header X-SFPY-SIGNATURE)
# Docs: https://safepay-docs.netlify.app/
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_PLAN_STARTER=
SAFEPAY_PLAN_GROWTH=
SAFEPAY_PLAN_ENTERPRISE=
# Optional static checkout URL when API keys are unset (dev fallback)
SAFEPAY_CHECKOUT_URL=

# Deprecated / unused — Lemon Squeezy retired from the live billing path
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_CHECKOUT_URL=
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=
# LEMONSQUEEZY_VARIANT_STARTER=
# LEMONSQUEEZY_VARIANT_GROWTH=
# LEMONSQUEEZY_VARIANT_ENTERPRISE=
# LEMONSQUEEZY_CAMPAIGN_VARIANT_ID=

FBR_API_BASE_URL=
FBR_POS_TOKEN=
# Optional Expo push access token for production delivery
EXPO_ACCESS_TOKEN=
